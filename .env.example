# Copy to .env and configure locally. Never commit a real key.
# Environment variables already set in the shell take precedence.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
PORT=8080
# Off by default; set to azure only once the Day 4 index is accessible.
KYC_POLICY_SEARCH=off
KYC_POLICY_AS_OF_DATE=2026-11-05
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=
AZURE_SEARCH_QUERY_KEY=
# Optional path to the Day 4 .env file; the course client reads only the
# three Azure query settings from it. Direct settings above take precedence.
KYC_SEARCH_ENV_FILE=
# Optional: path for the local SQLite database. Defaults to demo.sqlite3.
# ONBOARDING_DB=
